{% extends "layout.twig" %}

{% block content %}

<h2>Mes réservations</h2>

{% if items is empty %}
    <p>Aucune réservation.</p>
{% endif %}

{% for r in items %}
    <div style="padding:10px; border:1px solid #ddd; width:300px; margin-bottom:15px;">
        <strong>{{ r.restaurant_name }}</strong><br>
        Date : {{ r.reservation_date }}<br>
        Heure : {{ r.reservation_time }}<br>
        Code : <strong>{{ r.code }}</strong><br>
        <form method="POST" action="/reservation/delete" style="display:inline;">
            <input type="hidden" name="_csrf" value="{{ csrf_token }}">
            <input type="hidden" name="id" value="{{ r.id }}">
            <button type="submit">Supprimer</button>
        </form>
    </div>
{% endfor %}

{% endblock %}
