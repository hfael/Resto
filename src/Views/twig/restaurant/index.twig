{% extends "layout.twig" %}

{% block content %}
<h2>Liste des restaurants</h2>

<label for="searchInput">Recherche</label>
<input type="text" id="searchInput" placeholder="Rechercher..." style="margin-bottom:10px" aria-label="Recherche restaurant">

<div id="results" aria-live="polite">
    {% for r in items %}
        {{ r.name }} - {{ r.average_price }}EUR
        <a href="/restaurant/show?id={{ r.id }}">Details</a>

        {% if session.user_role == 'admin' or r.created_by == session.user_id %}
            <a href="/restaurant/edit?id={{ r.id }}">Modifier</a>
            <form method="POST" action="/restaurant/delete" style="display:inline;">
                <input type="hidden" name="_csrf" value="{{ csrf_token }}">
                <input type="hidden" name="id" value="{{ r.id }}">
                <button type="submit">Supprimer</button>
            </form>
        {% endif %}

        <br>
    {% else %}
        <p>Aucun restaurant disponible.</p>
    {% endfor %}
</div>

<br>
<a href="/restaurant/create">Ajouter un restaurant</a>

<script>
const input = document.getElementById('searchInput');
const results = document.getElementById('results');
const csrfToken = '{{ csrf_token }}';

const userId = '{{ session.user_id }}';
const userRole = '{{ session.user_role }}';

function esc(value) {
    return String(value ?? '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
}

input.addEventListener('input', function() {
    const q = this.value;

    fetch('/restaurant/search?q=' + encodeURIComponent(q))
        .then(res => res.json())
        .then(data => {
            results.innerHTML = '';

            if (data.length === 0) {
                results.innerHTML = '<p>Aucun resultat</p>';
                return;
            }

            data.forEach(item => {
                let html = esc(item.name) + ' - ' + esc(item.average_price) + 'EUR ';
                html += "<a href='/restaurant/show?id=" + esc(item.id) + "'>Details</a> ";

                if (userRole === 'admin' || item.created_by == userId) {
                    html += "<a href='/restaurant/edit?id=" + esc(item.id) + "'>Modifier</a> ";
                    html += "<form method='POST' action='/restaurant/delete' style='display:inline;'>";
                    html += "<input type='hidden' name='_csrf' value='" + esc(csrfToken) + "'>";
                    html += "<input type='hidden' name='id' value='" + esc(item.id) + "'>";
                    html += "<button type='submit'>Supprimer</button>";
                    html += '</form>';
                }

                html += '<br>';
                results.innerHTML += html;
            });
        });
});
</script>
{% endblock %}
